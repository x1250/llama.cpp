#version 450

// hyper-connection gated stream mean:
//   dst[i, t] = inv_hc * sum_h x[i, h, t] * sigmoid(gate[i, h, t])
// one thread per output element; the rows are contiguous, the stream and token strides come in elements

layout(constant_id = 0) const uint BLOCK_SIZE = 256;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer X    { float data_x[]; };
layout(binding = 1) readonly  buffer Gate { float data_g[]; };
layout(binding = 2) writeonly buffer Dst  { float data_d[]; };

layout(push_constant) uniform PushConstants {
    uint ne0; uint ne1; uint ne2;
    uint nb01; uint nb02;
    uint nb11; uint nb12;
    uint nb21;
    float inv_hc;
};

void main() {
    const uint i0 = gl_GlobalInvocationID.x;
    const uint it = gl_GlobalInvocationID.y;

    if (i0 >= ne0 || it >= ne2) {
        return;
    }

    // precise keeps the product and the sum as two roundings, bit-identical to the unfused MUL and ADD nodes
    precise float sum = 0.0f;

    for (uint ih = 0; ih < ne1; ++ih) {
        const float xv = data_x[i0 + ih*nb01 + it*nb02];
        const float gv = data_g[i0 + ih*nb11 + it*nb12];
        sum += xv * (1.0f / (1.0f + exp(-gv)));
    }

    data_d[i0 + it*nb21] = sum * inv_hc;
}
